{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arboresce project workflow v1 contract definitions",
  "description": "Library only: select a named $defs target. The root deliberately rejects every instance. See the workspace/project workflow requirements for parser, transport, authorization, revision-CAS and operation-specific obligations.",
  "not": {},
  "$defs": {
    "workspace_reference": {
      "description": "Selected Organization tenant and its exact default Domain. Workspace terminology resolves to these canonical wire identifiers.",
      "type": "object",
      "required": ["organization_id", "domain_id"],
      "properties": {
        "organization_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "domain_id": {"$ref": "common.schema.json#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "iana_timezone": {
      "description": "Selected IANA timezone identifier used to interpret attributed relative dates. It is not the process or upload timezone.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_+\\-]*(?:/[A-Za-z][A-Za-z0-9_+\\-]*)*(?![\\s\\S])"
    },
    "temporal_basis": {
      "description": "Attributed event date/precision, selected IANA timezone and versioned relative-date rule used for interpretation. A date-only value is never coerced to an instant.",
      "type": "object",
      "required": ["event", "timezone", "relative_date_rule_version"],
      "properties": {
        "event": {"$ref": "#/$defs/project_date"},
        "timezone": {"$ref": "#/$defs/iana_timezone"},
        "relative_date_rule_version": {"$ref": "common.schema.json#/$defs/slug"}
      },
      "additionalProperties": false
    },
    "proposal_origin": {
      "description": "Exact immutable origin of one proposal: the admitted capture revision, the analysis run identity, the selected immutable processing profile and the attributed temporal basis. Absence of this origin is not inferred evidence.",
      "type": "object",
      "required": ["capture", "analysis_id", "analysis_revision", "processing_profile_digest", "temporal_basis"],
      "properties": {
        "capture": {"$ref": "observation.schema.json#/$defs/capture_reference"},
        "analysis_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "analysis_revision": {"$ref": "common.schema.json#/$defs/content_revision"},
        "processing_profile_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "temporal_basis": {"$ref": "#/$defs/temporal_basis"}
      },
      "additionalProperties": false
    },
    "relationship_subject": {
      "description": "Typed subject of a responsibility or due date: explicit project-level scope or an exact same-workspace project record revision.",
      "oneOf": [
        {
          "type": "object",
          "required": ["scope"],
          "properties": {"scope": {"const": "project"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["record"],
          "properties": {"record": {"$ref": "#/$defs/project_record_reference"}},
          "additionalProperties": false
        }
      ]
    },
    "party_kind": {
      "description": "A party is a person or an external business, never a principal, membership, organization or grant.",
      "type": "string",
      "enum": ["person", "external_business"]
    },
    "party_alias_status": {
      "type": "string",
      "enum": ["known", "ambiguous", "unverified"]
    },
    "party_alias": {
      "description": "One attributed name or spelling. Ambiguity and non-verification are preserved rather than collapsed.",
      "type": "object",
      "required": ["value", "status"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "status": {"$ref": "#/$defs/party_alias_status"}
      },
      "additionalProperties": false
    },
    "party_detail": {
      "type": "object",
      "required": ["kind", "value", "status"],
      "properties": {
        "kind": {"$ref": "common.schema.json#/$defs/slug"},
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "status": {"$ref": "#/$defs/party_alias_status"}
      },
      "additionalProperties": false
    },
    "party_reference": {
      "type": "object",
      "required": ["party_id", "content_revision"],
      "properties": {
        "party_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "content_revision": {"$ref": "common.schema.json#/$defs/content_revision"}
      },
      "additionalProperties": false
    },
    "party_record": {
      "description": "Stable workspace-scoped Party content revision. Aliases and details may be unresolved or unverified.",
      "type": "object",
      "required": ["workspace", "party_id", "content_revision", "kind", "aliases", "details"],
      "properties": {
        "workspace": {"$ref": "#/$defs/workspace_reference"},
        "party_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "content_revision": {"$ref": "common.schema.json#/$defs/content_revision"},
        "kind": {"$ref": "#/$defs/party_kind"},
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/party_alias"}
        },
        "details": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/party_detail"}
        }
      },
      "additionalProperties": false
    },
    "party_role": {
      "description": "Separate relationship roles. Holding one role never implies another.",
      "type": "string",
      "enum": ["supplier", "speaker", "participant", "assignee", "reviewer", "executor"]
    },
    "project_reference": {
      "type": "object",
      "required": ["project_id", "content_revision"],
      "properties": {
        "project_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "content_revision": {"$ref": "common.schema.json#/$defs/content_revision"}
      },
      "additionalProperties": false
    },
    "project_record_kind": {
      "type": "string",
      "enum": [
        "description",
        "context",
        "participant",
        "decision",
        "work_item",
        "responsibility",
        "due_date",
        "status",
        "fact"
      ]
    },
    "project_record_reference": {
      "type": "object",
      "required": ["kind", "record_id", "content_revision"],
      "properties": {
        "kind": {"$ref": "#/$defs/project_record_kind"},
        "record_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "content_revision": {"$ref": "common.schema.json#/$defs/content_revision"}
      },
      "additionalProperties": false
    },
    "work_item_state": {
      "description": "Planned or assigned work is not evidence of completion.",
      "type": "string",
      "enum": ["planned", "in_progress", "completed", "cancelled", "unknown"]
    },
    "decision_state": {
      "type": "string",
      "enum": ["proposed", "conditional", "agreed", "rejected", "unknown"]
    },
    "responsibility_state": {
      "description": "Distinguishes a reported assignment from an accepted product update and independently established agreement.",
      "type": "string",
      "enum": ["reported", "product_update", "agreed"]
    },
    "project_date": {
      "description": "Either a date-only value or an exact UTC instant, never both and never a coerced midnight.",
      "type": "object",
      "required": ["precision"],
      "properties": {
        "precision": {"type": "string", "enum": ["date", "instant"]},
        "value": {"type": "string", "minLength": 10, "maxLength": 24}
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "precision": {"const": "date"},
            "value": {"$ref": "common.schema.json#/$defs/calendar_date"}
          },
          "required": ["value"]
        },
        {
          "properties": {
            "precision": {"const": "instant"},
            "value": {"$ref": "common.schema.json#/$defs/timestamp"}
          },
          "required": ["value"]
        }
      ]
    },
    "lineage_category": {
      "type": "string",
      "enum": ["source_observation", "retained_context", "deterministic_default", "model_inference"]
    },
    "source_observation_lineage": {
      "type": "object",
      "required": ["category", "observation"],
      "properties": {
        "category": {"const": "source_observation"},
        "observation": {"$ref": "observation.schema.json#/$defs/observation_reference"}
      },
      "additionalProperties": false
    },
    "retained_context_lineage": {
      "type": "object",
      "required": ["category", "record"],
      "properties": {
        "category": {"const": "retained_context"},
        "record": {"$ref": "#/$defs/project_record_reference"}
      },
      "additionalProperties": false
    },
    "deterministic_default_lineage": {
      "type": "object",
      "required": ["category", "rule_version", "applies_to"],
      "properties": {
        "category": {"const": "deterministic_default"},
        "rule_version": {"$ref": "common.schema.json#/$defs/slug"},
        "applies_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "model_inference_lineage": {
      "type": "object",
      "required": ["category", "profile", "profile_digest", "basis", "alternatives", "unresolved"],
      "properties": {
        "category": {"const": "model_inference"},
        "profile": {"$ref": "common.schema.json#/$defs/slug"},
        "profile_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "alternatives": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
          }
        },
        "unresolved": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
          }
        }
      },
      "additionalProperties": false
    },
    "lineage_entry": {
      "description": "Lineage categories are not interchangeable; each entry states exactly one category.",
      "oneOf": [
        {"$ref": "#/$defs/source_observation_lineage"},
        {"$ref": "#/$defs/retained_context_lineage"},
        {"$ref": "#/$defs/deterministic_default_lineage"},
        {"$ref": "#/$defs/model_inference_lineage"}
      ]
    },
    "field_lineage_entry": {
      "description": "Explicit binding of one consequential field path to its own lineage entries. Aggregate prose lineage cannot identify which field was sourced, inherited, defaulted or inferred.",
      "type": "object",
      "required": ["field", "entries"],
      "properties": {
        "field": {"$ref": "#/$defs/changed_field"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/lineage_entry"}
        }
      },
      "additionalProperties": false
    },
    "evidence_role": {
      "type": "string",
      "enum": ["supporting", "refuting", "qualifying"]
    },
    "evidence_reference": {
      "type": "object",
      "required": ["role", "observation"],
      "properties": {
        "role": {"$ref": "#/$defs/evidence_role"},
        "observation": {"$ref": "observation.schema.json#/$defs/observation_reference"}
      },
      "additionalProperties": false
    },
    "unresolved_value": {
      "type": "object",
      "required": ["field", "requirement"],
      "properties": {
        "field": {"$ref": "#/$defs/changed_field"},
        "requirement": {
          "type": "string",
          "enum": ["clarification", "unknown", "conflict"]
        }
      },
      "additionalProperties": false
    },
    "change_dependency": {
      "description": "Exact same-workspace item revision or committed record; acyclic and explicit.",
      "oneOf": [
        {
          "type": "object",
          "required": ["item_id", "content_revision"],
          "properties": {
            "item_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "content_revision": {"$ref": "common.schema.json#/$defs/content_revision"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["record"],
          "properties": {"record": {"$ref": "#/$defs/project_record_reference"}},
          "additionalProperties": false
        }
      ]
    },
    "change_operation": {
      "type": "string",
      "enum": ["create", "revise", "associate"]
    },
    "project_record_target": {
      "description": "Stable typed identity of the exact existing or proposed project record. A bare revision number does not identify a record.",
      "type": "object",
      "required": ["kind", "record_id"],
      "properties": {
        "kind": {"$ref": "#/$defs/project_record_kind"},
        "record_id": {"$ref": "common.schema.json#/$defs/identifier"}
      },
      "additionalProperties": false
    },
    "target_predicate": {
      "description": "A typed target identity plus exactly one of an expected content revision or an explicit creation-absense predicate. The record identity is required in both cases; the proposed record identity names the creation being asserted absent. This is a per-target fence, never a whole-project revision fence.",
      "type": "object",
      "required": ["record"],
      "properties": {
        "record": {"$ref": "#/$defs/project_record_target"},
        "expected": {"$ref": "common.schema.json#/$defs/content_revision"},
        "absent": {"const": true}
      },
      "additionalProperties": false,
      "oneOf": [
        {"required": ["expected"], "properties": {"absent": false}},
        {"required": ["absent"], "properties": {"expected": false}}
      ]
    },
    "changed_field": {
      "description": "Unambiguous path to one consequential field: the candidate statement or a nested project content field such as content.statement or content.due.value. A bare single-segment name is accepted only when it is unambiguous in context.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*(?![\\s\\S])"
    },
    "record_statement": {
      "type": "object",
      "required": ["kind", "statement"],
      "properties": {
        "kind": {"const": "description"},
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "record_context": {
      "type": "object",
      "required": ["kind", "summary", "established"],
      "properties": {
        "kind": {"const": "context"},
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "established": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "record_participant": {
      "type": "object",
      "required": ["kind", "party", "role", "assent_reported"],
      "properties": {
        "kind": {"const": "participant"},
        "party": {"$ref": "#/$defs/party_reference"},
        "role": {"$ref": "#/$defs/party_role"},
        "assent_reported": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "record_decision": {
      "type": "object",
      "required": ["kind", "statement", "state"],
      "properties": {
        "kind": {"const": "decision"},
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "state": {"$ref": "#/$defs/decision_state"}
      },
      "additionalProperties": false
    },
    "record_work_item": {
      "type": "object",
      "required": ["kind", "statement", "state"],
      "properties": {
        "kind": {"const": "work_item"},
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "state": {"$ref": "#/$defs/work_item_state"}
      },
      "additionalProperties": false
    },
    "record_responsibility": {
      "type": "object",
      "required": ["kind", "party", "role", "state", "subject"],
      "properties": {
        "kind": {"const": "responsibility"},
        "party": {"$ref": "#/$defs/party_reference"},
        "role": {"$ref": "#/$defs/party_role"},
        "state": {"$ref": "#/$defs/responsibility_state"},
        "subject": {"$ref": "#/$defs/relationship_subject"}
      },
      "additionalProperties": false
    },
    "record_due_date": {
      "type": "object",
      "required": ["kind", "due", "subject"],
      "properties": {
        "kind": {"const": "due_date"},
        "due": {"$ref": "#/$defs/project_date"},
        "subject": {"$ref": "#/$defs/relationship_subject"}
      },
      "additionalProperties": false
    },
    "record_status": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "status"},
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "record_fact": {
      "type": "object",
      "required": ["kind", "name", "value"],
      "properties": {
        "kind": {"const": "fact"},
        "name": {"$ref": "common.schema.json#/$defs/slug"},
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "project_record_content": {
      "oneOf": [
        {"$ref": "#/$defs/record_statement"},
        {"$ref": "#/$defs/record_context"},
        {"$ref": "#/$defs/record_participant"},
        {"$ref": "#/$defs/record_decision"},
        {"$ref": "#/$defs/record_work_item"},
        {"$ref": "#/$defs/record_responsibility"},
        {"$ref": "#/$defs/record_due_date"},
        {"$ref": "#/$defs/record_status"},
        {"$ref": "#/$defs/record_fact"}
      ]
    },
    "project_change_item_base": {
      "type": "object",
      "required": [
        "item_id",
        "candidate",
        "workspace",
        "project",
        "origin",
        "operation",
        "record_kind",
        "content",
        "target",
        "changed_fields",
        "statement",
        "scope",
        "qualifications",
        "evidence",
        "field_lineage",
        "unresolved",
        "dependencies"
      ],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "candidate": {"$ref": "candidate-review.schema.json#/$defs/candidate_reference"},
        "workspace": {"$ref": "#/$defs/workspace_reference"},
        "project": {"$ref": "#/$defs/project_reference"},
        "origin": {"$ref": "#/$defs/proposal_origin"},
        "operation": {"$ref": "#/$defs/change_operation"},
        "record_kind": {"$ref": "#/$defs/project_record_kind"},
        "content": {"$ref": "#/$defs/project_record_content"},
        "target": {"$ref": "#/$defs/target_predicate"},
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/changed_field"}
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "scope": {"$ref": "candidate-review.schema.json#/$defs/candidate_scope"},
        "qualifications": {"$ref": "candidate-review.schema.json#/$defs/content_items"},
        "evidence": {"$ref": "candidate-review.schema.json#/$defs/evidence_roles"},
        "field_lineage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/field_lineage_entry"}
        },
        "unresolved": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/unresolved_value"}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/change_dependency"}
        }
      },
      "additionalProperties": false
    },
    "project_change_item": {
      "description": "One independently reviewable typed project change over complete proposed content. It carries its own immutable candidate revision/digest and exact capture/analysis origin, binds content kind to record_kind, binds each consequential field to its own lineage, and requires an explicit absence target for a create. It never introduces a second approval ledger.",
      "allOf": [
        {"$ref": "#/$defs/project_change_item_base"},
        {
          "oneOf": [
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "description"}, "content": {"$ref": "#/$defs/record_statement"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "description"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "context"}, "content": {"$ref": "#/$defs/record_context"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "context"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "participant"}, "content": {"$ref": "#/$defs/record_participant"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "participant"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "decision"}, "content": {"$ref": "#/$defs/record_decision"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "decision"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "work_item"}, "content": {"$ref": "#/$defs/record_work_item"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "work_item"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "responsibility"}, "content": {"$ref": "#/$defs/record_responsibility"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "responsibility"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "due_date"}, "content": {"$ref": "#/$defs/record_due_date"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "due_date"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "status"}, "content": {"$ref": "#/$defs/record_status"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "status"}}}}}}},
            {"required": ["record_kind", "content"], "properties": {"record_kind": {"const": "fact"}, "content": {"$ref": "#/$defs/record_fact"}, "target": {"properties": {"record": {"properties": {"kind": {"const": "fact"}}}}}}}
          ]
        },
        {
          "if": {"required": ["operation"], "properties": {"operation": {"const": "create"}}},
          "then": {"properties": {"target": {"required": ["absent"], "properties": {"absent": {"const": true}}}}},
          "else": {"properties": {"target": {"required": ["expected"]}}}
        }
      ]
    },
    "project_change_item_reference": {
      "type": "object",
      "required": ["item_id", "content_revision"],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "content_revision": {"$ref": "common.schema.json#/$defs/content_revision"}
      },
      "additionalProperties": false
    },
    "project_change_batch": {
      "description": "A reviewable presentation grouping, not an indivisible approval or distributed transaction.",
      "type": "object",
      "required": ["workspace", "project", "items"],
      "properties": {
        "workspace": {"$ref": "#/$defs/workspace_reference"},
        "project": {"$ref": "#/$defs/project_reference"},
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/project_change_item"}
        }
      },
      "additionalProperties": false
    },
    "project_item_verdict": {
      "type": "string",
      "enum": ["accept", "reject", "pending"]
    },
    "project_item_edit": {
      "description": "An attributable manual revision that never alters original media, observations or prior verdicts. It binds to the exact base candidate revision and digest it supersedes and may replace the typed project effect and the reviewable candidate content (statement, scope, qualifications, evidence, field lineage).",
      "type": "object",
      "required": ["item_id", "base_candidate", "content", "changed_fields"],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "base_candidate": {"$ref": "candidate-review.schema.json#/$defs/candidate_reference"},
        "content": {"$ref": "#/$defs/project_record_content"},
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/changed_field"}
        },
        "statement": {"type": "string", "minLength": 1, "maxLength": 16384},
        "scope": {"$ref": "candidate-review.schema.json#/$defs/candidate_scope"},
        "qualifications": {"$ref": "candidate-review.schema.json#/$defs/content_items"},
        "evidence": {"$ref": "candidate-review.schema.json#/$defs/evidence_roles"},
        "field_lineage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/field_lineage_entry"}
        }
      },
      "additionalProperties": false
    },
    "project_effect_mapping": {
      "description": "The accepted item bound to its exact candidate revision/digest and mapped to the exact project record revision. This is the project member of the single review ledger, never a detached ID-only effect.",
      "type": "object",
      "required": ["item_id", "candidate", "target"],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "candidate": {"$ref": "candidate-review.schema.json#/$defs/candidate_reference"},
        "target": {"$ref": "#/$defs/project_record_reference"}
      },
      "additionalProperties": false
    },
    "project_review_request": {
      "description": "A reviewer decision input bound to the exact candidate revision/digest and observed aggregate control revision. It is not itself a verdict record or a second ledger.",
      "type": "object",
      "required": ["item_id", "candidate", "expected_control_revision", "verdict", "reason"],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "candidate": {"$ref": "candidate-review.schema.json#/$defs/candidate_reference"},
        "expected_control_revision": {"$ref": "common.schema.json#/$defs/control_revision"},
        "verdict": {"$ref": "#/$defs/project_item_verdict"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 8192}
      },
      "additionalProperties": false
    },
    "project_review_record": {
      "description": "Versioned project extension of the candidate/review family. It retains the candidate verdict semantics and binds an accepted verdict to the exact typed project effect mapping without requiring a knowledge publication.",
      "type": "object",
      "required": ["review_id", "candidate", "control_revision", "verdict", "reason", "recorded_at", "audit_event_id"],
      "properties": {
        "review_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "candidate": {"$ref": "candidate-review.schema.json#/$defs/candidate_reference"},
        "control_revision": {"allOf": [{"$ref": "common.schema.json#/$defs/control_revision"}], "properties": {"value": {"not": {"const": "1"}}}},
        "verdict": {"enum": ["accepted", "rejected", "contested"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 8192},
        "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "audit_event_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "mapping": {"$ref": "#/$defs/project_effect_mapping"}
      },
      "additionalProperties": false,
      "oneOf": [
        {"required": ["mapping"], "properties": {"verdict": {"const": "accepted"}}},
        {"properties": {"verdict": {"enum": ["rejected", "contested"]}, "mapping": false}}
      ]
    },
    "project_change_resource": {
      "description": "One project change item with its candidate review state. The review reuses the versioned project review variant; no parallel project approval ledger exists, and a superseded revision retains its prior review.",
      "type": "object",
      "required": ["item", "control_revision", "revision_state", "review", "superseded_by"],
      "properties": {
        "item": {"$ref": "#/$defs/project_change_item"},
        "control_revision": {"$ref": "common.schema.json#/$defs/control_revision"},
        "revision_state": {"type": "string", "enum": ["pending", "accepted", "rejected", "contested", "superseded"]},
        "review": {"oneOf": [{"$ref": "#/$defs/project_review_record"}, {"type": "null"}]},
        "superseded_by": {"oneOf": [{"$ref": "candidate-review.schema.json#/$defs/candidate_reference"}, {"type": "null"}]}
      },
      "additionalProperties": false,
      "if": {"properties": {"revision_state": {"not": {"const": "pending"}}}},
      "then": {"properties": {"control_revision": {"properties": {"value": {"not": {"const": "1"}}}}}},
      "allOf": [
        {
          "if": {"properties": {"revision_state": {"const": "superseded"}, "review": {"type": "object"}}},
          "then": {"properties": {"control_revision": {"properties": {"value": {"not": {"enum": ["1", "2"]}}}}}}
        },
        {
          "if": {"properties": {"item": {"properties": {"candidate": {"properties": {"version": {"properties": {"value": {"not": {"const": "1"}}}}}}}}}},
          "then": {"properties": {"control_revision": {"properties": {"value": {"not": {"const": "1"}}}}}}
        }
      ],
      "oneOf": [
        {"properties": {"revision_state": {"const": "pending"}, "review": {"type": "null"}, "superseded_by": {"type": "null"}}},
        {"properties": {"revision_state": {"const": "accepted"}, "review": {"allOf": [{"$ref": "#/$defs/project_review_record"}], "properties": {"verdict": {"const": "accepted"}}}, "superseded_by": {"type": "null"}}},
        {"properties": {"revision_state": {"const": "rejected"}, "review": {"allOf": [{"$ref": "#/$defs/project_review_record"}], "properties": {"verdict": {"const": "rejected"}}}, "superseded_by": {"type": "null"}}},
        {"properties": {"revision_state": {"const": "contested"}, "review": {"allOf": [{"$ref": "#/$defs/project_review_record"}], "properties": {"verdict": {"const": "contested"}}}, "superseded_by": {"type": "null"}}},
        {"properties": {"revision_state": {"const": "superseded"}, "review": {"oneOf": [{"$ref": "#/$defs/project_review_record"}, {"type": "null"}]}, "superseded_by": {"allOf": [{"$ref": "candidate-review.schema.json#/$defs/candidate_reference"}], "properties": {"version": {"properties": {"value": {"not": {"const": "1"}}}}}}}}
      ]
    },
    "expense_project_association": {
      "description": "Typed versioned relationship to the exact expense revision, distinct from financial confirmation.",
      "type": "object",
      "required": ["workspace", "project", "expense_id", "expense_revision", "association_revision"],
      "properties": {
        "workspace": {"$ref": "#/$defs/workspace_reference"},
        "project": {"$ref": "#/$defs/project_reference"},
        "expense_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "expense_revision": {"$ref": "common.schema.json#/$defs/content_revision"},
        "association_revision": {"$ref": "common.schema.json#/$defs/content_revision"}
      },
      "additionalProperties": false
    }
  }
}
