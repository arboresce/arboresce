{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arboresce acquisition v1 contract definitions",
  "description": "Select a named definition. Parsed-value validation does not establish ownership, streamed byte identity, clock/lease checks, aggregate arithmetic or atomic state transitions.",
  "not": {},
  "$defs": {
    "byte_identity": {
      "type": "object",
      "required": ["sha256", "byte_length"],
      "properties": {
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "additionalProperties": false
    },
    "upload_generation": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "upload_generation"},
        "value": {"$ref": "common.schema.json#/$defs/positive_revision_value"}
      },
      "additionalProperties": false
    },
    "declared_original": {
      "type": "object",
      "required": ["format", "media_type", "sha256", "byte_length"],
      "properties": {
        "format": {"enum": ["plain_text", "markdown", "json", "jpeg", "png", "wav", "m4a"]},
        "media_type": {"type": "string"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 26214400}
      },
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"format": {"const": "plain_text"}, "media_type": {"const": "text/plain"}, "byte_length": {"maximum": 10485760}}},
        {"properties": {"format": {"const": "markdown"}, "media_type": {"const": "text/markdown"}, "byte_length": {"maximum": 10485760}}},
        {"properties": {"format": {"const": "json"}, "media_type": {"const": "application/json"}, "byte_length": {"minimum": 1, "maximum": 10485760}}},
        {"properties": {"format": {"const": "jpeg"}, "media_type": {"const": "image/jpeg"}, "byte_length": {"minimum": 1, "maximum": 26214400}}},
        {"properties": {"format": {"const": "png"}, "media_type": {"const": "image/png"}, "byte_length": {"minimum": 1, "maximum": 26214400}}},
        {"properties": {"format": {"const": "wav"}, "media_type": {"const": "audio/wav"}, "byte_length": {"minimum": 1, "maximum": 20971520}}},
        {"properties": {"format": {"const": "m4a"}, "media_type": {"const": "audio/mp4"}, "byte_length": {"minimum": 1, "maximum": 20971520}}}
      ]
    },
    "attachment_role": {"enum": ["evidence", "user_note", "supporting"]},
    "attachment_intent": {
      "type": "object",
      "required": ["upload_id", "generation", "source", "role", "required"],
      "properties": {
        "upload_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "generation": {"$ref": "#/$defs/upload_generation"},
        "source": {"$ref": "#/$defs/declared_original"},
        "role": {"$ref": "#/$defs/attachment_role"},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "attachment_intents": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/attachment_intent"}
    },
    "resource_response": {
      "allOf": [{"$ref": "common.schema.json#/$defs/response_object"}],
      "properties": {
        "code": false,
        "status": false,
        "error": false,
        "failure": false,
        "failure_code": false,
        "success": false,
        "accepted": false,
        "result": false,
        "ready": false,
        "bucket": false,
        "key": false,
        "sealed_key": false,
        "storage_key": false,
        "storage_url": false,
        "credentials": false
      }
    },
    "original_reference": {
      "type": "object",
      "required": ["organization_id", "artifact_id", "version_id", "source"],
      "properties": {
        "organization_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "artifact_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "version_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "source": {"$ref": "#/$defs/declared_original"}
      },
      "additionalProperties": false
    },
    "original_version": {
      "allOf": [{"$ref": "#/$defs/resource_response"}],
      "required": ["reference", "recorded_at"],
      "properties": {
        "reference": {"$ref": "#/$defs/original_reference"},
        "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "state": false,
        "problem": false,
        "url": false
      }
    },
    "representation": {
      "allOf": [{"$ref": "#/$defs/resource_response"}],
      "required": ["representation_id", "original", "bytes", "media_type", "processor", "profile_digest", "recorded_at"],
      "properties": {
        "representation_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "original": {"$ref": "#/$defs/original_reference"},
        "bytes": {"$ref": "#/$defs/byte_identity"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9.+-]*/[a-z][a-z0-9.+-]*(?![\\s\\S])"},
        "processor": {"$ref": "common.schema.json#/$defs/slug"},
        "profile_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "state": false,
        "problem": false,
        "url": false
      }
    },
    "sealed_binding": {
      "allOf": [{"$ref": "#/$defs/resource_response"}],
      "required": ["upload_id", "generation", "original"],
      "properties": {
        "upload_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "generation": {"$ref": "#/$defs/upload_generation"},
        "original": {"$ref": "#/$defs/original_version"},
        "state": false,
        "problem": false,
        "url": false
      }
    },
    "upload_resource": {
      "allOf": [{"$ref": "#/$defs/resource_response"}],
      "required": ["upload_id", "organization_id", "generation", "source", "state", "expires_at"],
      "properties": {
        "upload_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "organization_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "generation": {"$ref": "#/$defs/upload_generation"},
        "source": {"$ref": "#/$defs/declared_original"},
        "state": {"enum": ["created", "uploading", "uploaded", "sealing", "sealed", "expired", "aborted", "rejected"]},
        "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "binding": {"$ref": "#/$defs/sealed_binding"},
        "problem": {"$ref": "common.schema.json#/$defs/problem"},
        "url": false
      },
      "oneOf": [
        {"properties": {"state": {"enum": ["created", "uploading", "uploaded", "sealing", "expired", "aborted"]}, "binding": false, "problem": false}},
        {"required": ["binding"], "properties": {"state": {"const": "sealed"}, "problem": false}},
        {"required": ["problem"], "properties": {"state": {"const": "rejected"}, "binding": false}}
      ]
    },
    "staging_grant": {
      "allOf": [{"$ref": "common.schema.json#/$defs/response_object"}, {"$ref": "common.schema.json#/$defs/result_object"}],
      "required": ["method", "url", "required_headers", "expires_at"],
      "properties": {
        "method": {"const": "PUT"},
        "url": {"type": "string", "minLength": 12, "maxLength": 4096, "format": "uri", "pattern": "^https://[^\\u0000-\\u0020\\u007f]+(?![\\s\\S])"},
        "required_headers": {
          "type": "object",
          "maxProperties": 8,
          "required": ["content-type"],
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"},
          "properties": {"authorization": false, "proxy-authorization": false, "cookie": false, "host": false, "connection": false, "transfer-encoding": false},
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"}
        },
        "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "bucket": false,
        "key": false,
        "credentials": false
      }
    },
    "attachment_readiness": {
      "allOf": [{"$ref": "#/$defs/resource_response"}],
      "required": ["intent", "state"],
      "properties": {
        "intent": {"$ref": "#/$defs/attachment_intent"},
        "state": {"enum": ["incomplete", "ready", "failed"]},
        "binding": {"$ref": "#/$defs/sealed_binding"},
        "problem": {"$ref": "common.schema.json#/$defs/problem"}
      },
      "oneOf": [
        {"properties": {"state": {"const": "incomplete"}, "binding": false, "problem": false}},
        {"required": ["binding"], "properties": {"state": {"const": "ready"}, "problem": false}},
        {"required": ["problem"], "properties": {"state": {"const": "failed"}}}
      ]
    },
    "required_part": {"allOf": [{"$ref": "#/$defs/attachment_readiness"}], "properties": {"intent": {"properties": {"required": {"const": true}}}}},
    "required_failed_part": {"allOf": [{"$ref": "#/$defs/required_part"}], "properties": {"state": {"const": "failed"}}},
    "required_incomplete_part": {"allOf": [{"$ref": "#/$defs/required_part"}], "properties": {"state": {"const": "incomplete"}}},
    "capture_readiness": {
      "allOf": [{"$ref": "#/$defs/resource_response"}],
      "required": ["state", "attachments"],
      "properties": {
        "state": {"enum": ["incomplete", "ready", "failed"]},
        "attachments": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/attachment_readiness"}},
        "problem": false,
        "binding": false
      },
      "oneOf": [
        {"properties": {"state": {"const": "failed"}, "attachments": {"contains": {"$ref": "#/$defs/required_failed_part"}}}},
        {"properties": {"state": {"const": "ready"}, "attachments": {"contains": {"$ref": "#/$defs/required_part"}, "items": {"not": {"anyOf": [{"$ref": "#/$defs/required_failed_part"}, {"$ref": "#/$defs/required_incomplete_part"}]}}}}},
        {"properties": {"state": {"const": "incomplete"}, "attachments": {"not": {"contains": {"$ref": "#/$defs/required_failed_part"}}, "anyOf": [{"not": {"contains": {"$ref": "#/$defs/required_part"}}}, {"contains": {"$ref": "#/$defs/required_incomplete_part"}}]}}}
      ]
    },
    "capture_revision": {
      "type": "object",
      "required": ["capture_id", "organization_id", "domain_id", "version", "user_context", "attachments"],
      "properties": {
        "capture_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "organization_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "domain_id": {"$ref": "common.schema.json#/$defs/identifier"},
        "version": {"$ref": "common.schema.json#/$defs/content_revision"},
        "user_context": {"type": "string", "maxLength": 65536},
        "attachments": {"$ref": "#/$defs/attachment_intents"}
      },
      "additionalProperties": false
    },
    "capture_resource": {
      "allOf": [{"$ref": "#/$defs/resource_response"}],
      "required": ["revision", "control_revision", "submission_state", "readiness"],
      "properties": {
        "revision": {"$ref": "#/$defs/capture_revision"},
        "control_revision": {"$ref": "common.schema.json#/$defs/control_revision"},
        "submission_state": {"enum": ["draft", "submitted"]},
        "readiness": {"$ref": "#/$defs/capture_readiness"},
        "state": false,
        "problem": false,
        "binding": false
      },
      "if": {"properties": {"submission_state": {"const": "submitted"}}},
      "then": {
        "properties": {
          "control_revision": {"properties": {"value": {"not": {"const": "1"}}}},
          "revision": {"properties": {"attachments": {"minItems": 1, "contains": {"properties": {"required": {"const": true}}}}}},
          "readiness": {"properties": {"attachments": {"minItems": 1, "contains": {"$ref": "#/$defs/required_part"}}}}
        }
      }
    },
    "upload_allocation_request": {
      "type": "object",
      "required": ["metadata", "body"],
      "properties": {
        "metadata": {"allOf": [{"$ref": "common.schema.json#/$defs/command_metadata"}], "properties": {"command": {"const": "upload.allocate"}}},
        "body": {"type": "object", "required": ["source"], "properties": {"source": {"$ref": "#/$defs/declared_original"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "upload_finalize_request": {
      "type": "object",
      "required": ["metadata", "body"],
      "properties": {
        "metadata": {"allOf": [{"$ref": "common.schema.json#/$defs/command_metadata"}], "properties": {"command": {"const": "upload.finalize"}}},
        "body": {
          "type": "object",
          "required": ["upload_id", "expected_generation", "expected_source"],
          "properties": {
            "upload_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "expected_generation": {"$ref": "#/$defs/upload_generation"},
            "expected_source": {"$ref": "#/$defs/declared_original"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capture_create_request": {
      "type": "object",
      "required": ["metadata", "body"],
      "properties": {
        "metadata": {"allOf": [{"$ref": "common.schema.json#/$defs/command_metadata"}], "properties": {"command": {"const": "capture.create"}}},
        "body": {"type": "object", "required": ["user_context", "attachments"], "properties": {"user_context": {"type": "string", "maxLength": 65536}, "attachments": {"$ref": "#/$defs/attachment_intents"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "capture_revise_request": {
      "type": "object",
      "required": ["metadata", "body"],
      "properties": {
        "metadata": {"allOf": [{"$ref": "common.schema.json#/$defs/command_metadata"}], "properties": {"command": {"const": "capture.revise"}}},
        "body": {
          "type": "object",
          "required": ["capture_id", "expected_version", "expected_control_revision", "user_context", "attachments"],
          "properties": {
            "capture_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "expected_version": {"$ref": "common.schema.json#/$defs/content_revision"},
            "expected_control_revision": {"$ref": "common.schema.json#/$defs/control_revision"},
            "user_context": {"type": "string", "maxLength": 65536},
            "attachments": {"$ref": "#/$defs/attachment_intents"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "capture_submit_request": {
      "type": "object",
      "required": ["metadata", "body"],
      "properties": {
        "metadata": {"allOf": [{"$ref": "common.schema.json#/$defs/command_metadata"}], "properties": {"command": {"const": "capture.submit"}}},
        "body": {
          "type": "object",
          "required": ["capture_id", "expected_version", "expected_control_revision"],
          "properties": {
            "capture_id": {"$ref": "common.schema.json#/$defs/identifier"},
            "expected_version": {"$ref": "common.schema.json#/$defs/content_revision"},
            "expected_control_revision": {"$ref": "common.schema.json#/$defs/control_revision"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "upload_allocation_response": {
      "allOf": [{"$ref": "common.schema.json#/$defs/success_response"}],
      "required": ["idempotency_receipt"],
      "properties": {
        "result": {
          "required": ["upload", "staging_grant"],
          "properties": {
            "upload": {"allOf": [{"$ref": "#/$defs/upload_resource"}], "properties": {"state": {"const": "created"}, "generation": {"properties": {"value": {"const": "1"}}}}},
            "staging_grant": {"$ref": "#/$defs/staging_grant"}
          }
        }
      }
    },
    "upload_finalize_accepted_response": {
      "allOf": [{"$ref": "common.schema.json#/$defs/accepted_response"}],
      "required": ["upload"],
      "properties": {"upload": {"allOf": [{"$ref": "#/$defs/upload_resource"}], "properties": {"state": {"const": "sealing"}}}}
    },
    "upload_finalize_completed_response": {
      "allOf": [{"$ref": "common.schema.json#/$defs/success_response"}],
      "required": ["idempotency_receipt"],
      "properties": {"result": {"required": ["upload"], "properties": {"upload": {"allOf": [{"$ref": "#/$defs/upload_resource"}], "properties": {"state": {"const": "sealed"}}}}}}
    },
    "capture_response": {
      "allOf": [{"$ref": "common.schema.json#/$defs/success_response"}],
      "required": ["idempotency_receipt"],
      "properties": {"result": {"required": ["capture"], "properties": {"capture": {"$ref": "#/$defs/capture_resource"}}}}
    },
    "capture_create_response": {
      "allOf": [{"$ref": "#/$defs/capture_response"}],
      "properties": {"result": {"properties": {"capture": {"properties": {"submission_state": {"const": "draft"}, "control_revision": {"properties": {"value": {"const": "1"}}}, "revision": {"properties": {"version": {"properties": {"value": {"const": "1"}}}}}}}}}}
    },
    "capture_revise_response": {
      "allOf": [{"$ref": "#/$defs/capture_response"}],
      "properties": {
        "result": {
          "properties": {
            "capture": {
              "properties": {
                "submission_state": {"const": "draft"},
                "control_revision": {"properties": {"value": {"not": {"const": "1"}}}},
                "revision": {"properties": {"version": {"properties": {"value": {"not": {"const": "1"}}}}}}
              }
            }
          }
        }
      }
    },
    "capture_submit_response": {
      "allOf": [{"$ref": "#/$defs/capture_response"}],
      "properties": {"result": {"properties": {"capture": {"properties": {"submission_state": {"const": "submitted"}}}}}}
    }
  }
}
