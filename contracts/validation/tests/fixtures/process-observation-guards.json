      "independent_encoded_identity": {
        "bytes": 65536,
        "sha256": "2fd96bb694f96a17b184dc729992700c32d90406078313ac478c0e8f809dacea"
      }
    },
    {
      "id": "observation-save-one-byte-over",
      "operation": "save_observation",
      "setup": {
        "data": {
          "x": {
            "byte": "a",
            "repeat": 65527
          }
        },
        "original": null,
        "output_absent": true
      },
      "expected": {
        "encoded_bytes": 65537,
        "exception": "ValueError",
        "message": "observation exceeds 64 KiB",
