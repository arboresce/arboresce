        "command": []
      },
      "expected": {
        "exception": "SystemExit",
        "code": 2,
        "stderr_contains": "complete CLI arguments must follow --",
        "target_launches": 0,
        "target_and_observation_paths_stay_absent": true,
        "argv_restored": true,
        "borrowed_pipes_cleaned_by_test": true
