  "descriptor_close_cases": [
    {
      "id": "descriptor-close-unrecognized",
      "operation": "record_descriptor_close",
      "setup": {
        "kind": "real-os-pipe",
        "initial_events": [],
        "initial_errors": [],
        "live_occurrence": 7,
        "live_descriptor": "actual owned read endpoint",
        "actual_operation": "close the actual owned write endpoint once",
        "direct_fd": null,
        "direct_event": "c_return",
        "event_provenance": "Constructed direct unit input; no sys.setprofile event claim."
      },
      "expected": {
        "actual_close_result": null,
        "exception": null,
        "return_value": null,
        "events": [],
        "errors": [],
        "live_unchanged": true,
        "owned_read_endpoint_retained": true,
        "remaining_owned_endpoints_closed_once": true,
        "target_launches": 0
      }
    },
    {
      "id": "descriptor-close-owned-success",
      "operation": "record_descriptor_close",
      "setup": {
        "kind": "real-os-pipe",
        "initial_events": [],
        "initial_errors": [],
        "live_occurrence": 7,
        "live_descriptor": "actual owned read endpoint",
        "actual_operation": "close the actual owned read endpoint once, retaining the real None result",
        "direct_fd": "the same actual read descriptor value",
        "direct_event": "c_return",
        "event_provenance": "Constructed direct unit input after an actual successful close; not a captured profile event."
      },
      "expected": {
        "actual_close_result": null,
        "exception": null,
        "return_value": null,
        "live": {},
        "errors": [],
        "event_count": 1,
        "event_keys": [
          "event",
          "monotonic",
          "fd",
          "occurrence"
        ],
        "event": "descriptor-close",
        "event_fd": "the actual just-closed read descriptor value",
        "event_occurrence": 7,
        "event_monotonic": "actual finite value between immediately surrounding monotonic observations, before the unchanged original suite deadline",
        "remaining_owned_endpoints_closed_once": true,
        "closed_descriptor_not_requeried": true,
        "target_launches": 0
      }
    },
    {
      "id": "descriptor-close-error-event",
      "operation": "record_descriptor_close",
      "setup": {
        "kind": "actual-invalid-descriptor-close",
        "descriptor": -1,
        "actual_operation": "os.close(-1), with the real exception captured and its except scope left before helper invocation",
        "initial_events": [],
        "initial_errors": [],
        "initial_live": {},
        "direct_fd": -1,
        "direct_event": "c_exception",
        "event_provenance": "Constructed direct c_exception unit input after the actual invalid-descriptor error. The constant -1 is never an owned or retired host descriptor; no real profile-event or owned-process claim."
      },
      "expected": {
        "actual_exception": "OSError",
        "actual_errno_symbol": "EBADF",
        "actual_errno": 9,
        "helper_exception": "OSError",
        "helper_message": "owned descriptor close failed",
        "helper_errno": null,
        "helper_cause": null,
        "helper_context": null,
        "helper_exception_is_actual_close_exception": false,
        "events": [],
        "errors": [],
        "live": {},
        "no_numeric_requery": true,
        "target_launches": 0
      }
    },
