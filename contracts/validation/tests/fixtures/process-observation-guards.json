{
  "schema_version": 1,
  "cases": [
    {
      "id": "barrier-ack-eof",
      "setup": {
        "kind": "real-os-pipe",
        "writer": "close before receive",
        "deadline": "original current suite deadline"
      },
      "action": "receive one required ACK byte from the live read endpoint",
      "expected": {
        "exception": "ValueError",
        "message": "barrier token mismatch",
        "observed_read": "",
        "target_launches": 0,
        "endpoints_closed": true
      }
    },
    {
      "id": "barrier-ack-wrong-token",
      "setup": {
        "kind": "real-os-pipe",
        "writer_bytes_utf8": "X",
        "deadline": "original current suite deadline"
      },
      "action": "receive one required ACK byte from the live read endpoint",
      "expected": {
        "exception": "ValueError",
        "message": "barrier token mismatch",
        "writer_bytes_consumed": 1,
        "target_launches": 0,
        "endpoints_closed": true
      }
    },
    {
      "id": "barrier-original-deadline-expired",
      "setup": {
        "kind": "real-os-pipe",
        "writer_bytes_utf8": "A",
        "deadline": 0.0
      },
      "action": "attempt ACK receive with expired original deadline",
      "expected": {
        "exception": "TimeoutError",
        "message": "barrier original deadline expired",
        "queued_byte_after_failure_utf8": "A",
        "target_launches": 0,
        "endpoints_closed": true
      }
    },
    {
      "id": "barrier-parent-mutation-failure",
      "setup": {
        "kind": "real-directory",
        "target": "missing/second.json",
        "target_exists": false
      },
      "action": "perform the one required remove mutation",
      "expected": {
        "exception": "FileNotFoundError",
        "target_still_absent": true,
        "acknowledgments_written": 0,
        "target_launches": 0
      }
    },
    {
      "id": "observation-write-failure-preserves-target-error",
      "setup": {
        "kind": "real-files",
        "output_utf8": "retained",
        "missing_target": "missing.json"
      },
      "action": "capture actual missing-file read exception, then exclusively write observation to already existing output",
      "expected": {
        "exception": "ExceptionGroup",
        "member_types_in_order": [
          "FileNotFoundError",
          "FileExistsError"
        ],
        "first_member_is_actual_caught_exception": true,
        "output_utf8_unchanged": "retained",
        "target_launches": 0
      }
    }
  ],
  "boundary_cases": [
    {
      "id": "source-record-exact-1mib",
      "operation": "source_record",
      "setup": {
        "file": {
          "byte": "a",
          "repeat": 1048576
        }
      },
      "expected": {
        "bytes": 1048576,
        "content_unchanged": true,
        "record_keys": [
          "path",
          "bytes",
          "sha256"
        ],
        "record_path": "exact actual input path",
        "read_closed": true
      },
      "independent_payload_identity": {
        "bytes": 1048576,
        "sha256": "9bc1b2a288b26af7257a36277ae3816a7d4f16e89c1e7e77d0a5c48bad62b360"
      }
    },
    {
      "id": "source-record-one-byte-over",
      "operation": "source_record",
      "setup": {
        "file": {
          "byte": "a",
          "repeat": 1048577
        }
      },
      "expected": {
        "exception": "ValueError",
        "message": "observation source exceeds limit",
        "content_unchanged": true,
        "record_returned": false,
        "read_closed": true
      },
      "independent_payload_identity": {
        "bytes": 1048577,
        "sha256": "4a3f0c0c213adea174f9a3d4c13177315b588bdb2e9c1012d3d0bf0453ca0f6a"
      }
    },
    {
      "id": "event-cap-last-and-first-rejected",
      "operation": "emit_event",
      "setup": {
        "constructed_state_only": true,
        "event_count": 1023,
        "event_rows": {
          "event": "fixture",
          "monotonic": 0
        },
        "errors": []
      },
      "actions": [
        {
          "event": "boundary",
          "fields": {
            "path": "fixture-path"
          }
        },
        {
          "event": "overflow",
          "fields": {}
        }
      ],
      "expected": {
        "first_count": 1024,
        "first_appended_keys": [
          "event",
          "monotonic",
          "path"
        ],
        "first_event": "boundary",
        "first_path": "fixture-path",
        "first_monotonic": "actual finite nondecreasing clock observation",
        "second_exception": "ValueError",
        "second_message": "observation event limit",
        "second_count": 1024,
        "prior_records_unchanged": true
      }
    },
    {
      "id": "failure-log-sixteen-and-overflow",
      "operation": "record_observation_failure",
      "setup": {
        "events": [],
        "errors": [],
        "real_missing_files": 17
      },
      "expected": {
        "recorded_errors": 16,
        "types": [
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError",
          "FileNotFoundError"
        ],
        "messages": "exact corresponding actual caught error text, including each actual missing path",
        "first_sixteen_preserved_in_order": true,
        "error_overflow": true,
        "events_unchanged": true
      }
    },
    {
      "id": "ipc-close-two-owned-endpoints",
      "operation": "close_ipc",
      "setup": {
        "real_pipe": true,
        "transfer_both_endpoints": true
      },
      "expected": {
        "ipc_closed": "both actual transferred descriptor identities in supplied order",
        "errors": [],
        "all_transferred_endpoints_closed": true,
        "no_descriptor_requery": true
      }
    },
    {
      "id": "ipc-close-invalid-then-owned-writer",
      "operation": "close_ipc",
      "setup": {
        "real_pipe": true,
        "fds": [
          "constant -1, never an owned or retired host descriptor",
          "actual owned write endpoint"
        ],
        "retain_reader_for_eof": true
      },
      "expected": {
        "ipc_closed": "only actual transferred writer identity",
        "errors": [
          {
            "type": "OSError",
            "message": "[Errno 9] Bad file descriptor"
          }
        ],
        "reader_observation": "real EOF after writer closure",
        "remaining_reader_cleanup": true,
        "continues_after_error": true,
        "no_descriptor_requery": true
      }
    },
    {
