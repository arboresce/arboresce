    {
      "id": "observation-save-collision-no-original",
      "operation": "save_observation",
      "setup": {
        "data": {
          "observed": true
        },
        "original": null,
        "output_utf8": "retained"
      },
      "expected": {
        "exception": "FileExistsError",
        "filename": "exact existing output path",
        "output_utf8": "retained",
        "grouped": false
      }
    },
    {
