  "dispatch_cases": [
    {
      "id": "dispatch-unadmitted-real-frame",
      "setup": {
        "frame": "actual current unit frame",
        "admitted_names": [],
        "callback": "actual file reader with an initially empty invocation log",
        "file_utf8": "observed\n",
        "continuation": "a retained actual callable"
      },
      "expected": {
        "result": null,
        "callback_calls": 0,
        "state_errors": [],
        "state_events_unchanged": true,
        "file_unchanged": true
      }
    },
    {
      "id": "dispatch-admitted-real-read",
      "setup": {
        "frame": "actual current unit frame",
        "admitted_names": "exact set containing that actual frame.f_code.co_filename",
        "event": "call (direct unit argument, not a target-event claim)",
        "arg": "actual Path of the real file",
        "callback": "actual file reader retaining received frame/event/arg and bytes",
        "file_utf8": "observed\n",
        "continuation": "a retained actual callable"
      },
      "expected": {
        "callback_calls": 1,
        "frame_identity_preserved": true,
        "event_value_preserved": true,
        "arg_identity_preserved": true,
        "read_utf8": "observed\n",
        "result_is_exact_continuation": true,
        "state_errors": [],
        "file_unchanged": true
      }
    },
    {
      "id": "dispatch-admitted-missing-file",
      "setup": {
        "frame": "actual current unit frame",
        "admitted_names": "that exact current filename",
        "arg": "actual absent task-owned path",
        "callback": "actual Path.read_bytes attempt",
        "continuation": "a retained actual callable"
      },
      "expected": {
        "callback_calls": 1,
        "result_is_exact_continuation": true,
        "errors_count": 1,
        "error_type": "FileNotFoundError",
        "error_message": "exact text of the actual caught filesystem error including the requested path",
        "error_propagated": false,
        "target_stays_absent": true
      }
    },
    {
      "id": "dispatch-python-raised-fatal-specimen",
      "setup": {
        "frame": "actual current unit frame",
        "admitted_names": "that exact current filename",
        "callback": "explicitly Python-raise one retained KeyboardInterrupt object",
        "fatal_message": "unit dispatch fatal specimen; no signal attempted",
        "continuation": null
      },
      "expected": {
        "callback_calls": 1,
        "errors_count": 1,
        "error_type": "KeyboardInterrupt",
        "error_message": "unit dispatch fatal specimen; no signal attempted",
        "raised_object_is_exact_original": true,
        "signal_or_process_operation": false
      }
    }
