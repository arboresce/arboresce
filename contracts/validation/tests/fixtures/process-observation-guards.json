    },
    {
      "id": "main-requires-command-separator",
      "operation": "main argparse admission only",
      "setup": {
        "all_required_flags_present": true,
        "cli_path": "fresh missing unit target",
        "observation_path": "fresh absent output",
        "fd_arguments": "two actual borrowed pipe endpoints, never consumed because parser admission fails",
