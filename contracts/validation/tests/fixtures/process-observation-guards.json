        "all_endpoints_closed": true
      }
    },
    {
      "id": "empty-pipe-receive-deadline",
      "operation": "receive_token",
      "setup": {
        "real_empty_pipe": true,
        "writer_remains_open_during_wait": true,
        "token_utf8": "A",
        "unit_deadline": "One observed absolute monotonic deadline, setup time +0.25 seconds, capped by the existing suite deadline; record once and never renew it. This is a unit invocation deadline, not replacement qualification evidence."
      },
      "expected": {
        "exception": "TimeoutError",
        "message": "barrier original deadline expired",
        "queued_bytes": 0,
        "all_endpoints_closed": true,
        "no_clock_or_select_mock": true,
        "no_retry": true
      }
    },
