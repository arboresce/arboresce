  "adapter_contract": {
    "privacy": "The private adapter is not a public tree or ordinary-string key abstraction. Duplicate admission and pointer lookup use original exact strings. Helpers use only owned factories to exercise the serializer protocol; no caller key enters parse/select.",
    "protocol": "__eq__ returns self is other; __ne__ returns self is not other; __hash__ returns immutable per-object ordinal0..M-1, always exact bool/int as appropriate. Inherited encode preserves string content; construction and ordinal mutation are sealed.",
    "observation": "Protocol helper returns actual equality/inequality in both operand orders, hash and inherited UTF-16/UTF-8 bytes, or the exception class name from every separate constructor/mutation attempt. Boundary helpers only expand literal input recipes and report actual selection; expected canonical recipes/hashes remain in assertions.",
    "bounds": "Maximum selected object has65535 members because its root counts toward65536 selected nodes. Source objects may have65536 members but cannot be selected whole; unchanged common boundary cases retain that rejection.",
    "shared_discriminators": "Also consume every unchanged shared Unicode/UTF-16/empty/control/supplementary/decoded-duplicate/property vector; this supplement does not replace them.",
    "thresholds": [
      6,
      11,
      22,
      43,
      86,
      171,
      342,
      683,
      1366,
      2731,
      5462,
      10923,
      21846,
      43691
    ]
  },
  "recipe_contract": {
    "object_members": "For object_members=count, indices are the exact integers range(0,count). Each key is key_prefix followed by its index as six-digit zero-padded ASCII decimal (format(index,\"06d\")). Emit the JSON string key, colon, and the exact value_utf8 token. reverse=true reverses only member order. Enclose with { and }, join members by comma, and add no whitespace, BOM or newline. An empty count emits {}. Source and expected recipes use this same byte-construction formula with their independently declared member order; neither computes selection, duplicate, numeric or canonicalization decisions.",
    "other": "Common parts/repeat/additional_members input recipes retain the exact recipe_contract in crates/arboresce-domain/tests/fixtures/source-json-v1/cases.json. No fixture text is executed."
  },
