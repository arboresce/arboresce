  "recipes": {
    "preparation": "Prepare exact source/pointer values first, then reset the per-case callback counter to zero immediately before SourceJson.parse and any subsequent select. Do not inspect/format hostile values between reset and invocation. Helpers dispatch only these named recipes; never eval recipe text.",
    "source_kinds": {
      "bytes": "source_utf8.encode(\"utf-8\") as exact bytes",
      "bytearray": "bytearray(source_utf8.encode(\"utf-8\"))",
      "memoryview": "memoryview(source_utf8.encode(\"utf-8\"))",
      "str": "source_utf8 as exact str",
      "bytes_subclass": "bytes.__new__(HostileBytes, source_utf8.encode(\"utf-8\"))",
      "none": "None",
      "bool": "True",
      "int": "0"
    },
    "pointer_kinds": {
      "str": "pointer as exact str",
      "str_subclass": "str.__new__(HostileStr, pointer)",
      "bytes": "pointer.encode(\"utf-8\") as exact bytes",
      "memoryview": "memoryview(pointer.encode(\"utf-8\"))",
      "none": "None",
      "bool": "True",
      "int": "0"
    },
    "hostile_subclasses": {
      "HostileBytes": {
        "base": "bytes",
        "methods": [
          "__bytes__",
          "__len__",
          "__iter__",
          "__getitem__"
        ]
      },
      "HostileStr": {
        "base": "str",
        "methods": [
          "__str__",
          "__len__",
          "__iter__",
          "__getitem__",
          "encode"
        ]
      },
      "method_behavior": "Every overridden method increments the shared per-case callback counter and raises RuntimeError(\"unexpected conversion callback\"). No custom construction override. Preparation uses only the named built-in __new__ factories. Reset after preparation."
    },
    "action_setup": "For every action with source_utf8, parse its exact UTF-8 bytes. For every selection action, select the exact empty string unless that row explicitly supplies pointer. Require successful admission before applying the action.",
    "actions": {
      "source_constructor": {
        "attempts": [
          "SourceJson()",
          "SourceJson(b\"null\")",
          "SourceJson(_nodes=())"
        ],
        "requirement": "Every separate attempt raises TypeError; a no-argument missing-required-argument check alone is insufficient."
      },
      "selection_constructor": {
        "attempts": [
          "CanonicalJsonSelection()",
          "CanonicalJsonSelection(b\"null\", bytes(32))",
          "CanonicalJsonSelection(_canonical=b\"null\", _digest=bytes(32))"
        ],
        "requirement": "Every separate attempt raises TypeError; unchecked data cannot enter through the normal constructor."
      },
      "source_assignment": "setattr(source, \"_nodes\", ())",
      "source_deletion": "delattr(source, \"_nodes\")",
      "selection_assignment": "setattr(selection, \"_canonical\", b\"false\")",
      "selection_deletion": "delattr(selection, \"_digest\")",
      "source_dict": "vars(source)",
      "selection_dict": "vars(selection)",
      "copy": "copy.copy(selection); the selection is the whole [1,2] at the empty pointer",
      "deepcopy": "copy.deepcopy(selection); the selection is the whole [1,2] at the empty pointer",
      "foreign_equality": "selection == b\"null\" with exact bytes operand",
      "bytes_mutation": "selection.as_bytes()[0] = 0x78",
      "getters": "Observe type(as_bytes()) is bytes, exact canonical bytes, byte_length(), and sha256().hex().",
      "digest": "Observe type(sha256()) is bytes, len(sha256()), and sha256().hex()."
    },
    "result_types": "Every successful selection must return exact built-in bytes from as_bytes() and exact built-in bytes of length 32 from sha256(). A read-only memoryview is insufficient.",
    "failure_observation": "Observe stage, str(value), repr(value), isinstance(value, BaseException), getattr(value, \"__context__\", None), and getattr(value, \"__cause__\", None). The latter two are both None. Never return or print the source or pointer."
  },
