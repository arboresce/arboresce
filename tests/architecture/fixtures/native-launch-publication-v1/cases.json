{
  "version": "native-launch-publication-v1",
  "profile": {
    "maximum_publication_wait_ms": 1000,
    "maximum_receipt_bytes": 65536,
    "poll_ms": 1,
    "native_observer_budget_ms": 3000,
    "parent_handshake_budget_ms": 2000,
    "cleanup_budget_ms": 2000,
    "caller_deadline": "single endpoint fixed before selection; effective endpoint is min(original caller deadline, outer entry+1000ms)",
    "ready_frame": "one complete strict JSON value followed by LF; publication only, never attestation",
    "selected_descriptor": "same actual regular descriptor and path identity through complete read and all acceptance rechecks",
    "original_receipt": "actual PreparedLaunch.record_diagnosed bytes for the real child, preserved separately before controlled owned mutation",
    "ambient": "unchanged real ambient context; ordinary main launch/completion/raw profile still conserved"
  },
  "required_proofs": [
    "actual_parent_and_child_identity",
    "genuine_original_receipt_preserved",
    "complete_actual_streams_and_trace_retained",
    "actual_peer_exit_and_signal",
    "owning_ambient_environment_unchanged",
    "same_context_launch_and_completion",
    "selected_ack_before_controlled_selected_path_mutation",
    "context_original_and_mutated_bytes_retained",
    "original_context_and_receipt_restored_only_after_child_completion",
    "no_readiness_token_substitutes_for_exact_admission"
  ],
